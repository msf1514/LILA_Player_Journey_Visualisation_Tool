{
  "name": "lila-player-journey-visualisation-tool",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Player journey visualisation tool for LILA BLACK telemetry",
  "scripts": {
    "build:maps": "node pipeline/minimaps.mjs",
    "build:data": "node pipeline/build.mjs",
    "prebuild": "npm run build:maps && npm run build:data",
    "dev": "vite",
    "build": "tsc -b --noCheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "preview:remote": "wrangler dev"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "deck.gl": "^9.1.0",
    "hyparquet": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "sharp": "^0.34.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.130.0"
  }
}
